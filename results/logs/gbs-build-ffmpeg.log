[  204s] shared=
[  204s] userlinkdir=
[  204s] userlink=
[  204s] 
[  204s] for x ; do
[  204s]     test "$cleared" || set -- ; cleared=1
[  204s] 
[  204s]     case "$x" in
[  204s]         -L-user-start)
[  204s]             userlinkdir=1
[  204s]             ;;
[  204s]         -L-user-end)
[  204s]             userlinkdir=
[  204s]             ;;
[  204s]         -L*)
[  204s]             test "$userlinkdir" && set -- "$@" "$x"
[  204s]             ;;
[  204s]         -l-user-start)
[  204s]             userlink=1
[  204s]             ;;
[  204s]         -l-user-end)
[  204s]             userlink=
[  204s]             ;;
[  204s]         crtbegin*.o|crtend*.o)
[  204s]             set -- "$@" $($cc -print-file-name=$x)
[  204s]             ;;
[  204s]         -lgcc|-lgcc_eh)
[  204s]             file=lib${x#-l}.a
[  204s]             set -- "$@" $($cc -print-file-name=$file)
[  204s]             ;;
[  204s]         -l*)
[  204s]             test "$userlink" && set -- "$@" "$x"
[  204s]             ;;
[  204s]         -shared)
[  204s]             shared=1
[  204s]             set -- "$@" -shared
[  204s]             ;;
[  204s]         -sysroot=*|--sysroot=*)
[  204s]             ;;
[  204s]         *)
[  204s]             set -- "$@" "$x"
[  204s]             ;;
[  204s]     esac
[  204s] done
[  204s] 
[  204s] exec $($cc -print-prog-name=ld) -nostdlib "$@" -lc -dynamic-linker "$ldso"
